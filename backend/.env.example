# CARLOS: Environment variables for the backend
# Copy this file to .env and complete with your values

# Port where the server runs
PORT=5000

# MongoDB connection URL
# Example: mongodb://localhost:27017/ecommerce
# Or if using MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/ecommerce
MONGODB_URI=mongodb://localhost:27017/ecommerce

# Secret key for JWT (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_secret_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
